{"nodes": [{"id": "github_workflows_scheduled_audit", "label": "Scheduled Azure Audit Workflow (root)", "file_type": "code", "source_file": ".github/workflows/scheduled-audit.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_scheduled_audit_immediate_trigger_rationale", "label": "Rationale: Immediate Analyzer Trigger via /fire Endpoint Supersedes Cron Timing", "file_type": "rationale", "source_file": ".github/workflows/scheduled-audit.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cron nominally runs at 07:30 UTC but GitHub Actions' scheduling delay means it actually fires anywhere from ~08:00 to ~12:00 UTC in practice, so it should not be relied on to line up with the analyzer routine's 08:00 UTC daily cron. This is no longer load-bearing anyway: collect fires the analyzer routine immediately via its /fire endpoint right after queuing analysis requests (see triggerAnalyzerRoutine in cmd/collect.go) \u2014 the routine's own daily cron is now just a fallback in case the immediate trigger fails. If ROUTINE_TRIGGER_TOKEN isn't set, collect just logs a note and continues; the routine's daily schedule still eventually picks up the work."}, {"id": "cli_engine_cmd_collect_triggeranalyzerroutine", "label": "triggerAnalyzerRoutine (cmd/collect.go)", "file_type": "code", "source_file": ".github/workflows/scheduled-audit.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "github_workflows_scheduled_audit_immediate_trigger_rationale", "target": "github_workflows_scheduled_audit", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/scheduled-audit.yml", "source_location": null, "weight": 1.0}, {"source": "github_workflows_scheduled_audit", "target": "cli_engine_cmd_collect_tr