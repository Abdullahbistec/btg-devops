# Path to the btg-devops executable (relative to web/ dir, or absolute)
BTG_DEVOPS_PATH=../btg-devops.exe

# ── Database ────────────────────────────────────────────────────────────────────
# Postgres connection string (web/lib/db.ts). Schema is applied automatically
# on first connect — no separate migration step. DATABASE_PATH/SQLite is gone;
# don't set it, it's no longer read anywhere that matters.
DATABASE_URL=postgresql://user:password@localhost:5432/btg_devops

# ── Admin account ───────────────────────────────────────────────────────────────
# Seeds the default admin user on first run, and is also the login the
# scheduled GitHub Actions workflow (.github/workflows/scheduled-audit.yml)
# and scripts/run-scheduled-*.js use to authenticate against the deployed app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-real

# Signs session cookies (web/lib/auth.ts). Change this from any placeholder
# value before deploying — anyone with this secret can forge a valid session.
SESSION_SECRET=generate-a-long-random-string

# Local development only: set to 1 to have /api/auth/login return the OTP in
# its response so you can sign in without SMTP configured. Ignored entirely
# when NODE_ENV=production. Never set this on a deployed instance — it is a
# complete MFA bypass for anyone who can read the response.
BTG_DEV_OTP=0

# ── Azure credentials (used by all Azure analyzers and PP analyzers by default) ──
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ── Power Platform credentials (optional override) ────────────────────────────
# If set, these are passed to the PP commands (pp-environments, pp-apps,
# pp-flows, pp-powerbi, powerplatform) instead of the AZURE_* values above.
# Use this when your PP service principal is different from your Azure one.
#
# Prerequisites (Global Admin must run once):
#   New-PowerAppManagementApp -ApplicationId <BTG_PP_CLIENT_ID>
# Then assign roles:
#   Power Platform Administrator  (pp-environments, pp-apps, pp-flows)
#   Power BI Administrator        (pp-powerbi)
#   Organization.Read.All (Graph) (powerplatform licensing)
#
BTG_PP_TENANT_ID=your-tenant-id
BTG_PP_CLIENT_ID=your-pp-client-id
BTG_PP_CLIENT_SECRET=your-pp-client-secret

# ── Hetzner credentials (optional — only needed if you scan Hetzner Cloud) ─────
# A single flat project-scoped API token, not OAuth. Scope it Read-only in
# Hetzner Cloud Console -> Security -> API Tokens; the analyzers never write.
HCLOUD_TOKEN=your-hetzner-project-token

# ── Subscription secret encryption ─────────────────────────────────────────────
# Encrypts Client Secret values entered via Settings -> Subscriptions before
# storing them in Postgres (web/lib/crypto.ts, AES-256-GCM — same scheme as
# external/yomal/CLI Engine's internal/crypto/crypto.go "aes256" provider).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=generate-a-base64-32-byte-key

# ── Async AI analysis via MCP + a scheduled Claude Code routine ─────────────────
# Powers the dashboard's "Summarize" button — routes through a Claude
# subscription's included quota instead of a metered API key. Requires
# running `btg-devops mcp --http` as a persistent process and a one-time
# manual setup at claude.ai/code/routines. Full walkthrough:
# docs/ai-analysis-routine-setup.md
#
# Token the MCP server (cmd/mcp.go --http) requires from callers — this is
# what you paste into the routine's config at claude.ai/code/routines.
MCP_BEARER_TOKEN=generate-a-random-secret

# Token the MCP server presents back to this dashboard's /api/internal/*
# routes. Different secret from MCP_BEARER_TOKEN — one authenticates the
# routine to the MCP server, this one authenticates the MCP server to here.
MCP_INTERNAL_TOKEN=generate-a-different-random-secret

# Local-dev alternative to the scheduled-routine setup above: spawns
# `claude -p` directly (web/lib/routine-trigger.ts) the moment a Summarize
# request is queued, instead of waiting for an external routine to poll.
# Still requires the MCP server running on :8090 and `claude` on PATH.
# SECURITY: this starts an agent with real tool access in direct response to
# an HTTP request. Leave unset (or 0) on any shared or internet-facing
# deployment — it is local-only by design. Unset or 0 disables it.
CLAUDE_DRAIN_ENABLED=0

# ── Email (audit-summary and registration notifications, web/lib/mailer.ts) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=BTG DevOps <your-smtp-username>

# ── Notifications ──────────────────────────────────────────────────────────────
# Base URL used to build the "view this audit" link in summary emails.
APP_URL=http://localhost:3000
# Comma-separated list of audit-summary recipients. Falls back to ADMIN_EMAIL if unset.
NOTIFICATION_EMAILS=alice@example.com,bob@example.com
