# Path to the btg-devops executable (relative to web/ dir, or absolute)
BTG_DEVOPS_PATH=../btg-devops.exe

# SQLite database file location
DATABASE_PATH=./btg-devops.db

# ── Azure credentials (used by all Azure analyzers and PP analyzers by default) ──
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# ── Power Platform credentials (optional override) ────────────────────────────
# If set, these are passed to the PP commands (pp-environments, pp-apps,
# pp-flows, pp-powerbi, powerplatform) instead of the AZURE_* values above.
# Use this when your PP service principal is different from your Azure one.
#
# Prerequisites (Global Admin must run once):
#   New-PowerAppManagementApp -ApplicationId <BTG_PP_CLIENT_ID>
# Then assign roles:
#   Power Platform Administrator  (pp-environments, pp-apps, pp-flows)
#   Power BI Administrator        (pp-powerbi)
#   Organization.Read.All (Graph) (powerplatform licensing)
#
BTG_PP_TENANT_ID=your-tenant-id
BTG_PP_CLIENT_ID=your-pp-client-id
BTG_PP_CLIENT_SECRET=your-pp-client-secret

# ── Subscription secret encryption ─────────────────────────────────────────────
# Encrypts Client Secret values entered via Settings -> Subscriptions before
# storing them in SQLite (web/lib/crypto.ts, AES-256-GCM — same scheme as
# external/yomal/CLI Engine's internal/crypto/crypto.go "aes256" provider).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=generate-a-base64-32-byte-key

# ── AI Assistant ────────────────────────────────────────────────────────────────
# Powers the dashboard's chat/summarize assistant over findings.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── Async AI analysis via MCP + a scheduled Claude Code routine ─────────────────
# Alternative to GEMINI_API_KEY above for the "Summarize" button specifically
# (Chat stays on Gemini either way) — routes through a Claude subscription's
# included quota instead of a metered API key. Requires running
# `btg-devops mcp --http` as a persistent process and a one-time manual setup
# at claude.ai/code/routines. Full walkthrough: docs/ai-analysis-routine-setup.md
#
# Token the MCP server (cmd/mcp.go --http) requires from callers — this is
# what you paste into the routine's config at claude.ai/code/routines.
MCP_BEARER_TOKEN=generate-a-random-secret

# Token the MCP server presents back to this dashboard's /api/internal/*
# routes. Different secret from MCP_BEARER_TOKEN — one authenticates the
# routine to the MCP server, this one authenticates the MCP server to here.
MCP_INTERNAL_TOKEN=generate-a-different-random-secret

# ── Notifications ──────────────────────────────────────────────────────────────
# Base URL used to build the "view this audit" link in summary emails.
APP_URL=http://localhost:3000
# Comma-separated list of audit-summary recipients. Falls back to ADMIN_EMAIL if unset.
NOTIFICATION_EMAILS=alice@example.com,bob@example.com
